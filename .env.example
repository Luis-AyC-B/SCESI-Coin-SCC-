# Postgres
POSTGRES_USER=scesi
POSTGRES_PASSWORD=scesi
POSTGRES_DB=scesi_coin
# Puerto del host; cambiar si 5432 ya está ocupado (y ajustar DATABASE_URL)
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://scesi:scesi@localhost:5432/scesi_coin

# Auth
JWT_SECRET=change-me

# Blockchain
RPC_URL=http://localhost:8545
# Clave Fernet para cifrar las llaves privadas de las wallets custodiales
WALLET_ENCRYPTION_KEY=change-me

# Frontend
VITE_API_URL=http://localhost:8000
